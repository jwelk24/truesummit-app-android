<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. Points the app at a network security config that allows
  cleartext to localhost so a backend running on the dev machine is reachable.
  Release builds never merge this, so they permit no cleartext.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
